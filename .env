

# # -----------------------------------------------------------------
# # 1. Flask 보안 설정
# # -----------------------------------------------------------------
# # SECRET_KEY: Flask 세션 암호화와 CSRF 보호에 사용되는 비밀 키
# # - 운영환경에서는 반드시 복잡하고 긴 랜덤한 문자열로 변경하세요
# # - 최소 32자 이상, 영문 대소문자, 숫자, 특수문자 조합 권장
# # - 예시: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=ant-together-production-secret-key-2025-make-this-very-long-and-random

# # -----------------------------------------------------------------
# # 2. 데이터베이스 설정
# # -----------------------------------------------------------------
# # DATABASE_URL: 데이터베이스 연결 URL
# # SQLite (개발용): sqlite:///파일명.db
# # PostgreSQL (운영용): postgresql://username:password@localhost:5432/database_name
# # MySQL (운영용): mysql://username:password@localhost:3306/database_name
# DATABASE_URL=sqlite:///ant_together.db

# # -----------------------------------------------------------------
# # 3. 이메일 서비스 설정 (Gmail SMTP)
# # -----------------------------------------------------------------
# # MAIL_USERNAME: Gmail 이메일 주소
# # - 이메일 인증, 비밀번호 재설정 등에 사용되는 발신자 이메일
# # - 반드시 실제 Gmail 계정을 입력하세요
# MAIL_USERNAME=your-gmail@gmail.com

# # MAIL_PASSWORD: Gmail 앱 비밀번호 (일반 비밀번호 아님!)
# # Gmail 앱 비밀번호 생성 방법:
# # 1. Gmail 계정 → Google 계정 관리
# # 2. 보안 탭 → 2단계 인증 활성화 (필수)
# # 3. 보안 탭 → 앱 비밀번호 클릭
# # 4. 앱 선택: 기타 → "ANT TOGETHER" 입력
# # 5. 생성된 16자리 비밀번호를 아래에 입력 (공백 제거)
# # 예시: abcdefghijklmnop
# MAIL_PASSWORD=your-16-digit-app-password

# # -----------------------------------------------------------------
# # 4. Flask 실행 환경 설정
# # -----------------------------------------------------------------
# # FLASK_ENV: Flask 실행 환경
# # - development: 개발 환경 (디버그 모드, 자동 재시작)
# # - production: 운영 환경 (최적화된 성능)
# FLASK_ENV=development

# # FLASK_DEBUG: 디버그 모드 활성화 여부
# # - True: 오류 발생시 상세한 에러 페이지 표시, 코드 변경시 자동 재시작
# # - False: 운영 환경에서는 반드시 False로 설정 (보안상 중요)
# FLASK_DEBUG=True

# # -----------------------------------------------------------------
# # 5. 선택사항: 추가 설정
# # -----------------------------------------------------------------
# # 다른 이메일 서비스를 사용하려면 아래 설정들을 수정하세요

# # MAIL_SERVER: SMTP 서버 주소
# # Gmail: smtp.gmail.com
# # Outlook: smtp-mail.outlook.com
# # Yahoo: smtp.mail.yahoo.com
# # MAIL_SERVER=smtp.gmail.com

# # MAIL_PORT: SMTP 포트 번호
# # TLS 사용시: 587
# # SSL 사용시: 465
# # MAIL_PORT=587

# # MAIL_USE_TLS: TLS 암호화 사용 여부
# # Gmail의 경우 True로 설정
# # MAIL_USE_TLS=True

# # -----------------------------------------------------------------
# # 6. 개발자 참고사항
# # -----------------------------------------------------------------
# # 이메일 기능을 테스트하지 않고 싶다면:
# # MAIL_USERNAME과 MAIL_PASSWORD를 빈 값으로 두세요
# # 예시:
# # MAIL_USERNAME=
# # MAIL_PASSWORD=
# # 
# # 이 경우 이메일 발송 기능은 비활성화되지만 
# # 나머지 로그인 기능은 정상 작동합니다

# # -----------------------------------------------------------------
# # 7. 보안 체크리스트
# # -----------------------------------------------------------------
# # ✅ SECRET_KEY가 32자 이상인가?
# # ✅ MAIL_PASSWORD가 Gmail 앱 비밀번호인가?
# # ✅ .env 파일이 .gitignore에 포함되어 있는가?
# # ✅ 운영 환경에서는 FLASK_DEBUG=False인가?

# # -----------------------------------------------------------------
# # 8. OpenAI API 키 설정
# # -----------------------------------------------------------------
# # OPENAI_API_KEY=